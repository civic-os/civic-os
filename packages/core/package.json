{
  "name": "@civic-os/core",
  "version": "0.79.0",
  "description": "Framework-agnostic interpreter of the Civic OS metadata contract",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "@civic-os/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@civic-os/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only && vitest run --config vitest.config.exact.ts --typecheck.only"
  },
  "dependencies": {}
}
