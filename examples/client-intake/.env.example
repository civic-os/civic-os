# Client Intake Example - Local Docker Development
# Copy to .env and customize if needed: cp .env.example .env
# Values below are safe local-dev defaults. Never commit real secrets.

# PostgreSQL Configuration
POSTGRES_DB=civic_os_db
POSTGRES_PASSWORD=securepassword123

# MinIO / S3 Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=civic-os-files
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Application URLs
SITE_URL=http://localhost:4200
API_URL=http://localhost:3000

# Notification Worker (defaults to the bundled Inbucket SMTP server)
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM='"Exemplary Community Services" <noreply@example.org>'
SMTP_REPLY_TO=
SKIP_TEST_EMAILS=false
NOTIFICATION_TIMEZONE=America/New_York
NOTIFICATION_TRACKING_ENABLED=true
TRACKING_PORT=8090
TRACKING_URL=http://localhost:8090

# SMS (fake mode by default; no Telnyx account needed)
SMS_ENABLED=false
SMS_FAKE_MODE=true
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=

# Worker tuning
DB_MAX_CONNS=4
DB_MIN_CONNS=1
THUMBNAIL_MAX_WORKERS=3
RECURRING_SERIES_HORIZON_DAYS=90
