# Copy to spaces.env (gitignored) for docker-compose.spaces.yml. Use a scratch bucket made for the check.
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=civic-os-spaces-check
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# Production instances sign with us-east-1 against Spaces (infrastructure/vps/.env.example)
SPACES_REGION=us-east-1
