/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.base.json",
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "module": "ES2022",
    /*
     * Workspace packages are consumed from TypeScript source by the app build,
     * `ng test`, and the import web worker (tsconfig.worker.json extends this
     * file). Paths resolve relative to this file (no baseUrl; deprecated in TS 6).
     */
    "paths": {
      "@civic-os/core": ["./packages/core/src/index.ts"],
      "@civic-os/core/testing": ["./packages/core/src/testing/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
