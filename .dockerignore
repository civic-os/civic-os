# Dependencies
# (.dockerignore patterns are anchored at the context root; the ** forms also
# exclude nested installs such as packages/*/node_modules and tools/*/node_modules)
node_modules/
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs (** also covers workspace builds such as packages/*/dist)
dist/
**/dist
.angular/
coverage/

# Environment files
.env
.env.*
*.env
!.env.example

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation (not needed in container)
*.md
!docker/README.md
docs/

# Example deployments (not needed in container)
examples/

# Test files
*.spec.ts
test-setup.ts

# CI/CD
.github/

# Debug
debug/
