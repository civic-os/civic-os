    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@geoman-io/leaflet-geoman-free": "^2.20.0",
    "@joint/core": "^4.3.2",
    "@pgsql/parser": "^1.2.1",
    "@texel/color": "^1.1.11",
    "@tiptap/core": "^3.31.2",
    "@tiptap/extension-bubble-menu": "^3.31.2",
