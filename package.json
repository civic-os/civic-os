{
  "name": "civic-os",
  "version": "0.76.4",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ng": "ng",
    "lint": "ng lint && eslint packages",
    "lint:dashes": "node scripts/check-typographic-dashes.cjs",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:headless": "ng test --watch=false",
    "test:ci": "ng test --watch=false --coverage",
    "build:packages": "tsc -b packages/core",
    "test:packages": "npm run test:packages:unit && npm run test:packages:types && npm run test:packages:tz",
    "test:packages:unit": "vitest run --root packages/core",
    "test:packages:types": "vitest run --root packages/core --typecheck.only",
    "test:packages:tz": "node scripts/test-packages-tz.mjs",
    "check:packages": "npm run check:publint && npm run check:attw && npm run api:check && npm run check:spdx && npm run check:versions && npm run check:boundaries && npm run check:docker-workspaces && npm run check:dogfood",
    "check:publint": "publint packages/core",
    "check:attw": "attw --pack packages/core --profile esm-only",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:versions": "node scripts/sync-versions.mjs --check",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docker-workspaces": "node scripts/check-docker-workspaces.mjs",
    "check:dogfood": "node scripts/check-dogfood.mjs",
    "api:report": "node scripts/api-report.mjs",
    "api:check": "node scripts/api-report.mjs --check",
    "generate": "ts-node scripts/generate-wrapper.ts",
    "update-version": "node scripts/update-version.js",
    "sync-versions": "node scripts/sync-versions.mjs",
    "postversion": "npm run update-version && npm run sync-versions",
    "prebuild": "npm run update-version",
    "a11y:pa11y": "pa11y-ci --config .pa11yci.json",
    "a11y:lighthouse": "lhci autorun",
    "a11y:audit": "lighthouse http://localhost:4200 --only-categories=accessibility --output=html --output-path=./baseline-lighthouse.html",
    "test:a11y-full": "npm run a11y:pa11y && npm run a11y:lighthouse"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/service-worker": "^22.1.5",
    "@dintecom/ngx-currency": "^22.0.0",
    "@floating-ui/dom": "^1.8.0",
    "@fullcalendar/angular": "^7.0.2",
    "@geoman-io/leaflet-geoman-free": "^2.20.0",
    "@joint/core": "^4.3.2",
    "@pgsql/parser": "^1.5.0",
    "@texel/color": "^1.1.11",
    "@tiptap/core": "^3.31.2",
    "@tiptap/extension-bubble-menu": "^3.31.2",
    "@tiptap/extension-floating-menu": "^3.31.2",
    "@tiptap/extension-link": "^3.31.2",
    "@tiptap/markdown": "^3.31.2",
    "@tiptap/pm": "^3.31.2",
    "@tiptap/starter-kit": "^3.31.2",
    "@types/dagre": "^0.7.54",
    "@types/leaflet": "^1.9.22",
    "@unovis/angular": "^1.6.7",
    "@unovis/ts": "^1.6.7",
    "blockly": "^13.2.1",
    "chrono-node": "^2.10.1",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.14",
    "fullcalendar": "^7.0.2",
    "keycloak-angular": "^22.0.0",
    "keycloak-js": "^26.2.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "marked-katex-extension": "^5.1.12",
    "mermaid": "^11.17.2",
    "ngx-image-cropper": "^9.1.7",
    "ngx-markdown": "^22.0.2",
    "ngx-mask": "^22.1.0",
    "ngx-matomo-client": "^10.0.0",
    "openapi-types": "^12.1.3",
    "prismjs": "^1.30.0",
    "rrule": "^2.8.1",
    "rxjs": "~7.8.2",
    "temporal-polyfill": "^1.0.4",
    "tslib": "^2.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/jointjs": "^1.0.5",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "angular-eslint": "^22.2.0",
    "autoprefixer": "^10.5.4",
    "daisyui": "^5.7.27",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.0",
    "istanbul-lib-instrument": "^6.0.3",
    "ng-packagr": "^22.2.4",
    "pa11y-ci": "^4.1.1",
    "pg": "^8.23.0",
    "playwright-core": "~1.59.1",
    "postcss": "^8.5.27",
    "publint": "^0.3.25",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
