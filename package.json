{
  "name": "civic-os",
  "version": "0.73.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "lint": "ng lint",
    "lint:dashes": "node scripts/check-typographic-dashes.cjs",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:headless": "ng test --browsers=ChromeHeadlessCI --watch=false",
    "test:ci": "ng test --browsers=ChromeHeadlessCI --watch=false --code-coverage",
    "generate": "ts-node scripts/generate-wrapper.ts",
    "update-version": "node scripts/update-version.js",
    "postversion": "npm run update-version",
    "prebuild": "npm run update-version",
    "a11y:pa11y": "pa11y-ci --config .pa11yci.json",
    "a11y:lighthouse": "lhci autorun",
    "a11y:audit": "lighthouse http://localhost:4200 --only-categories=accessibility --output=html --output-path=./baseline-lighthouse.html",
    "visual:reference": "backstop reference",
    "visual:test": "backstop test",
    "visual:approve": "backstop approve",
    "test:a11y-full": "npm run a11y:pa11y && npm run visual:test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.30",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.30",
